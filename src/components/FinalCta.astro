---
import { Image } from 'astro:assets';
import bgImg from '../assets/gallery/balcony-sunset.jpg';

const AIRBNB_URL = 'https://www.airbnb.com.sv/rooms/1466095984266019111';
---

<section class="final">
  <Image
    src={bgImg}
    alt="Vista del atardecer desde el balcón hacia Av. Edén"
    class="final-img"
    widths={[640, 960, 1400]}
    sizes="100vw"
    format="webp"
    quality={72}
  />
  <div class="final-scrim" aria-hidden="true"></div>
  <div class="wrap final-content reveal">
    <p class="eyebrow on-dark">Reservas por Airbnb</p>
    <h2>¿Reservamos<br />tu balcón?</h2>
    <p class="final-p">
      Esta página es solo informativa: fechas, precios y la reserva se
      gestionan 100% desde la publicación oficial en Airbnb.
    </p>
    <a class="btn btn-clay" href={AIRBNB_URL} target="_blank" rel="noopener">
      Ver disponibilidad en Airbnb →
    </a>
    <p class="final-rating"><span class="stars">★★★★★</span> 5.0 · Favorito de los huéspedes</p>
  </div>
</section>

<style>
  .final {
    position: relative;
    padding: 6.5rem 0;
    overflow: hidden;
    background: var(--pine);
  }
  .final-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
  }
  .final-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(19, 26, 21, 0.88), rgba(19, 26, 21, 0.82));
  }
  .final-content {
    position: relative;
    z-index: 2;
    text-align: center;
    max-width: 34rem;
    margin: 0 auto;
  }
  .eyebrow.on-dark {
    color: var(--brass);
  }
  .final h2 {
    color: var(--paper);
    font-size: clamp(2.2rem, 5vw, 3.4rem);
    margin: 0.9rem 0 1.2rem;
  }
  .final-p {
    color: var(--stone-dim);
    margin: 0 0 2rem;
  }
  .final-rating {
    margin: 1.4rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--stone);
  }
  .stars {
    color: var(--brass);
    letter-spacing: 0.1em;
  }
</style>
