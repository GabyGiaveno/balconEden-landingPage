---
import { Image } from 'astro:assets';
import heroImg from '../assets/gallery/living-balcony.jpg';

const AIRBNB_URL = 'https://www.airbnb.com.sv/rooms/1466095984266019111';
---

<section class="hero" id="top">
  <Image
    src={heroImg}
    alt="Living del departamento con puerta corrediza abierta al balcón, con la pileta del complejo de fondo"
    class="hero-img"
    widths={[640, 960, 1400, 1920]}
    sizes="100vw"
    format="webp"
    quality={78}
    loading="eager"
    fetchpriority="high"
  />
  <div class="hero-scrim" aria-hidden="true"></div>

  <div class="wrap hero-content">
    <p class="eyebrow hero-eyebrow">Av. Edén · La Falda, Córdoba</p>
    <h1 class="hero-title">La Falda,<br />desde el balcón.</h1>
    <p class="hero-sub">
      Un apart luminoso a metros del histórico Hotel Edén y a pocas cuadras del
      centro. Balcón propio, pileta compartida y todo nuevo — así lo cuentan
      los que ya se quedaron.
    </p>
    <div class="hero-actions">
      <a class="btn btn-clay" href={AIRBNB_URL} target="_blank" rel="noopener">
        Ver la publicación en Airbnb →
      </a>
      <p class="hero-rating">
        <span class="stars">★★★★★</span> 5.0 · Favorito de los huéspedes
      </p>
    </div>
  </div>

  <div class="railing on-dark hero-rail" aria-hidden="true"></div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    background: var(--pine);
  }
  .hero-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 70% 40%;
  }
  .hero-scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(0deg, rgba(20, 26, 20, 0.92) 0%, rgba(20, 26, 20, 0.55) 42%, rgba(20, 26, 20, 0.18) 68%, rgba(20, 26, 20, 0.35) 100%),
      linear-gradient(100deg, rgba(20, 26, 20, 0.55) 0%, rgba(20, 26, 20, 0.05) 55%);
  }
  .hero-content {
    position: relative;
    z-index: 2;
    padding-top: 8rem;
    padding-bottom: 3.5rem;
    max-width: 720px;
  }
  .hero-eyebrow {
    color: var(--brass);
    margin-bottom: 1.1rem;
  }
  .hero-title {
    color: var(--paper);
    font-size: clamp(2.6rem, 7vw, 5rem);
    margin-bottom: 1.4rem;
  }
  .hero-sub {
    color: var(--stone-dim);
    font-size: 1.1rem;
    max-width: 46ch;
    margin: 0 0 2rem;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem;
  }
  .hero-rating {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.05em;
    color: var(--stone);
  }
  .stars {
    color: var(--brass);
    letter-spacing: 0.1em;
  }
  .hero-rail {
    position: relative;
    z-index: 2;
  }
</style>
